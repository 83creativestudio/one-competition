{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateApplicationObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/tenant/*",
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/system/health/*"
      ]
    }
  ]
}
