# Provider overlay only. Merge into secured Production configuration; not deployable alone.
# Proposed hostname: create DNS, proxy routing and valid TLS BEFORE registering callbacks.
PLATFORM_BASE_DOMAIN=competition.onedigital.com.cy
PLATFORM_AUTH_DOMAIN=https://auth.competition.onedigital.com.cy

# Amazon SES, Frankfurt. These are SMTP credentials, NOT ordinary AWS access keys.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@competition.onedigital.com.cy
EMAIL_FROM_NAME="ONE. Competitions"
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Private Amazon S3 bucket. Supply a unique bucket name and least-privilege identity.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Real scanner required; S3 does not implement this HTTP scanner contract itself.
VIRUS_SCANNER_PROVIDER=http
VIRUS_SCANNER_ENDPOINT=

# Cloudflare Turnstile: allow the actual public competition hostname.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google OAuth web application. Server-side secrets only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Services ID, developer team/key IDs and complete private .p8 PEM.
# Store PEM as a quoted secret with literal \n escapes or use the secret manager's multiline support.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Meta application: permissions public_profile,email; no Page/Instagram actions.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Confirm a supported version in the Meta dashboard before enabling real traffic.
FACEBOOK_GRAPH_VERSION=v23.0
