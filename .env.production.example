ASPNETCORE_ENVIRONMENT=Production
DATABASE_PROVIDER=postgres
DATABASE_CONNECTION_STRING=Host=db.example.internal;Port=5432;Database=one_competitions;Username=one;Password=use-secret-manager;SSL Mode=Require;Trust Server Certificate=false
REDIS_CONNECTION_STRING=redis.example.internal:6380,ssl=true,password=use-secret-manager
JWT_SIGNING_KEY=use-a-random-secret-of-at-least-32-bytes
MFA_ISSUER=ONE. Competitions
ENCRYPTION_KEY=use-a-random-32-byte-base64-key
PLATFORM_BASE_DOMAIN=competitions.example.com
PLATFORM_AUTH_DOMAIN=auth.competitions.example.com
PLATFORM_QR_DOMAIN=go.competitions.example.com
PLATFORM_VERIFY_DOMAIN=verify.competitions.example.com
